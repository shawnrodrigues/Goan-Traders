# Goan Traders Environment Variables (Example)
# ============================================
# Copy this file to .env and add your actual webhook URL

# Discord Webhook for contact form submissions
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# Cloudflare Turnstile (Captcha)
# Get your keys from: https://dash.cloudflare.com/
CLOUDFLARE_TURNSTILE_SITE_KEY=YOUR_SITE_KEY_HERE
CLOUDFLARE_TURNSTILE_SECRET_KEY=YOUR_SECRET_KEY_HERE

# Environment
NODE_ENV=development
